{"file":"trust-feXk80G6.js","mappings":";;;;;;;;;;;;;;;;AAoBA,eAAW;AAAA,MACT,OAAO;AAAA,MACP,aAAa;AAAA,IAAA,CACd;;AAtBO,YAAA,QAAAA,eAAAC,WAAA,EAAA,OAAM,uCAAmC,MAAA,CAAA,CAAA,s9BAAA;AAAA;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps"],"sources":["../../../../pages/trust.vue"],"sourcesContent":["<template>\n  <main class=\"min-h-screen bg-white pt-24 pb-16\">\n    <div class=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <h1 class=\"text-4xl font-black text-slate-900 mb-6\">Trust & Safety Guidelines</h1>\n      <div class=\"prose prose-lg text-slate-600\">\n        <p>Your safety is our top priority. We've built Erranders Barter to be the safest place to trade on campus.</p>\n        \n        <h3 class=\"text-2xl font-bold text-slate-800 mt-8 mb-4\">Always Use Escrow</h3>\n        <p>Never pay directly into a seller's personal bank account. Always use the built-in Escrow system to protect your money.</p>\n        \n        <h3 class=\"text-2xl font-bold text-slate-800 mt-8 mb-4\">Meet in Public Spaces</h3>\n        <p>If you are not using Erranders Logistics, ensure you meet the other party in a well-lit, public location on campus during daylight hours.</p>\n\n        <h3 class=\"text-2xl font-bold text-slate-800 mt-8 mb-4\">Inspect Items Thoroughly</h3>\n        <p>Take your time to check the item before confirming delivery on the app. Once delivery is confirmed, funds are released and sales are final.</p>\n      </div>\n    </div>\n  </main>\n</template>\n<script setup>\nuseSeoMeta({\n  title: 'Trust & Safety | Erranders Barter',\n  description: 'Safety guidelines for buying, selling, and swapping on the Erranders network.'\n})\n</script>"],"version":3}