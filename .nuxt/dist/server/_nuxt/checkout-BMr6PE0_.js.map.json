{"file":"checkout-BMr6PE0_.js","mappings":";;;;;;;;;;;;;;;;;;;;AACO,MAAM,YAAY;AAAA,EACvB,UAAU,CAAC,SAAc,iBAAiB,KAAK,oBAAoB,IAAI;AAAA,EACvE,SAAS,CAAC,SAAiB,iBAAiB,MAAM,WAAW,IAAI,UAAU;AAAA,EAC3E,SAAS,CAAC,SAAiB,iBAAiB,MAAM,WAAW,IAAI,UAAU;AAAA,EAC3E,gBAAgB,MAAM,iBAAiB,IAAI,yBAAyB;AACtE;;;;;AC6Jc,aAAQ;AACtB,UAAM,SAAS,UAAS;AACxB,UAAM,EAAE,WAAU,IAAK,QAAO;AAC9B,UAAM,OAAO,IAAI,IAAI;AAErB,eAAW;AAAA,MACT,OAAO,SAAS,MAAM,KAAK,QAAQ,aAAa,KAAK,MAAM,KAAK,iBAAiB,sBAAsB;AAAA,MACvG,aAAa;AAAA,IACf,CAAC;AACD,UAAM,UAAU,IAAI,IAAI;AACxB,UAAM,aAAa,IAAI,KAAK;AAC5B,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,kBAAkB,IAAI,KAAK;AAEjC,UAAM,iBAAiB,IAAI,QAAQ;AACnC,UAAM,kBAAkB,IAAI,EAAE;AAC9B,UAAM,kBAAkB,IAAI,GAAG;AAC/B,UAAM,oBAAoB,IAAI,GAAG;AAEjC,UAAM,cAAc,SAAS,MAAM;AACjC,UAAI,CAAC,KAAK,MAAO,QAAO;AACxB,YAAM,cAAc,eAAe,UAAU,aAAa,kBAAkB,QAAQ;AACpF,aAAO,KAAK,MAAM,QAAQ;AAAA,IAC5B,CAAC;AAgCD,UAAM,oBAAoB,MAAM;AAC9B,sBAAgB,QAAQ;AACxB,qBAAc;AAAA,IAChB;AAEA,UAAM,iBAAiB,YAAY;AACjC,UAAI,eAAe,UAAU,cAAc,CAAC,gBAAgB,OAAO;AACjE,cAAM,QAAQ;AACd;AAAA,MACF;AAEA,iBAAW,QAAQ;AACnB,YAAM,QAAQ;AACd,UAAI;AACF,cAAM,UAAU;AAAA,UACZ,UAAU,KAAK,MAAM,SAAS,OAAO,KAAK,MAAM;AAAA,UAChD,QAAQ,KAAK,MAAM;AAAA,UACnB,QAAQ,YAAY;AAAA,UACpB,gBAAgB,eAAe;AAAA,UAC/B,iBAAiB,gBAAgB;AAAA,QACzC;AAEI,cAAM,EAAE,MAAM,OAAO,SAAQ,IAAK,MAAM,UAAU,SAAS,OAAO;AAElE,YAAI,UAAU;AACZ,gBAAM,QAAQ;AAAA,QAChB,OAAO;AACL,iBAAO,KAAK,SAAS;AAAA,QACvB;AAAA,MACF,SAAS,KAAK;AACZ,cAAM,QAAQ;AACd,gBAAQ,MAAM,GAAG;AAAA,MACnB,UAAC;AACC,mBAAW,QAAQ;AAAA,MACrB;AAAA,IACF;;;AA5PO,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,yDAAqD,MAAA,CAAA,CAAA,oDAAA;;QAIhD,IAAG;AAAA,QAAW,OAAM;AAAA;yBAA9B,CAEW,GAAAC,QAAAC,UAAA,aAAA;;AADE,YAAAD,OAAAE,mBAAAC,MAAA,SAAA,GAAA,EAAA,OAAM,kBAAc,MAAAF,UAAA,QAAA,CAAA;;;;cAA/BG,YAAkCD,MAAA,SAAA,GAAA,EAAvB,OAAM,eAAc,CAAA;AAAA,8BAAG,mBACpC;AAAA;;;;;;UAGS,QAAA,OAAO;;kBACD,KAAA,OAAI;;;;AAWA,YAAA,KAAA,MAAK,UAAU,WAAK,OAAO,SAAM,GAAA;qCAAO,OAAK,KAAA,MAAK,OAAM,CAAA,CAAA,CAAA,sCAAA;AAAA;;AAEpD,gBAAAD,mBAAAC,MAAA,WAAA,GAAA,EAAA,OAAM,UAAS,GAAA,MAAA,OAAA,CAAA;;;4FAIqCE,eAAA,KAAA,MAAK,KAAK,4EACtB,KAAA,MAAK,MAAM,eAAc,CAAA;AAExE,cAAAH,mBAAAC,MAAA,IAAA,GAAA,EAAA,OAAM,cAAa,GAAA,MAAA,OAAA,CAAA;yCAAe,KAAA,MAAK,UAAU,aAAS,SAAA,gMAQvB,KAAA,MAAK,MAAM,eAAc,CAAA,sFAG7C,eAAA,UAAc,aAAA,aAAA,QAAA,kEACK,eAAA,UAAc,aAAA,IAAsB,kBAAA,MAAkB,gBAAc,KAAA,MAAA,wUAU3DE,eAAA,YAAA,MAAY,eAAc,CAAA;AAMlE,cAAAH,mBAAAC,MAAA,WAAA,GAAA,EAAA,OAAM,yBAAwB,GAAA,MAAA,OAAA,CAAA;wrBAwB/B,eAAA,UAAc,WAAA,iCAAA,2CAAA,kFAAA,CAAA,kCAGT,eAAA,UAAc,WAAA,qBAAA,oBAAA,gFAAA,CAAA;YACd,eAAA,UAAc,UAAA;;;;;+XAanB,eAAA,UAAc,aAAA,iCAAA,2CAAA,kFAAA,CAAA,kCAGT,eAAA,UAAc,aAAA,qBAAA,oBAAA,gFAAA,CAAA;YACd,eAAA,UAAc,YAAA;;;;;;YAWtB,eAAA,UAAc,YAAA;;AAIX,gBAAAD,mBAAAC,MAAA,MAAA,GAAA,EAAA,OAAM,kEAAiE,GAAA,MAAA,OAAA,CAAA;gDAC/D,gBAAA,KAAe,yYAOmBE,eAAA,gBAAA,MAAgB,eAAc,CAAA,0RAKzD,kBAAA,KAAiB,kBAAiBC,cAAA,OAAK,gBAAA,KAAe;;;;gFAOlC,WAAA,SAAe,eAAA,UAAc,cAAA,CAAoB,gBAAA,KAAe,IAAA,cAAA,EAAA,8NAAA;YAChG,WAAA,OAAU;AAAE,gBAAAJ,mBAAAC,MAAA,OAAA,GAAA,EAAA,OAAM,uBAAsB,GAAA,MAAA,OAAA,CAAA;AAAA;AAC1C,gBAAAD,mBAAAC,MAAA,IAAA,GAAA,EAAA,OAAM,UAAS,GAAA,MAAA,OAAA,CAAA;AAAA;AACzB,cAAA,IAAAE,eAAA,WAAA,QAAU,kBAAsBF,MAAA,UAAA,IAAU,QAAW,YAAA,MAAY,eAAc,CAAA,cAAA,oBAAA,CAAA,WAAA;YAE3E,MAAA,OAAK;sHAAsF,MAAA,KAAK,CAAA,MAAA;AAAA;;;;;;;QAOrG,QAAQ,gBAAA;AAAA,QAAkB,qBAAO,gBAAA,QAAe;AAAA,QAAW,WAAS;AAAA;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_ssrRenderComponent","_unref","_createVNode","_ssrInterpolate","_ssrRenderAttr"],"sources":["../../../../api_factory/modules/escrow.ts","../../../../pages/checkout.vue"],"sourcesContent":["import { GATEWAY_ENDPOINT } from '../axios.config';\nexport const escrowApi = {\n  initiate: (data: any) => GATEWAY_ENDPOINT.post('/escrow/initiate', data),\n  release: (txId: string) => GATEWAY_ENDPOINT.patch(`/escrow/${txId}/release`),\n  dispute: (txId: string) => GATEWAY_ENDPOINT.patch(`/escrow/${txId}/dispute`),\n  myTransactions: () => GATEWAY_ENDPOINT.get('/escrow/my-transactions')\n};","<template>\n  <div class=\"min-h-screen bg-slate-50 py-16 px-4 sm:px-6 lg:px-8\">\n    <div class=\"max-w-5xl mx-auto\">\n      \n      <div class=\"mb-8\">\n        <NuxtLink to=\"/explore\" class=\"inline-flex items-center text-sm font-bold text-slate-500 hover:text-brand-600 transition-colors\">\n          <ArrowLeft class=\"w-4 h-4 mr-2\" /> Back to Explore\n        </NuxtLink>\n      </div>\n\n      <div v-if=\"loading\" class=\"text-center py-20 text-slate-500 font-bold\">Loading secure checkout...</div>\n      <div v-else-if=\"!item\" class=\"text-center py-20 text-red-500 font-bold\">Item not found.</div>\n      \n      <div v-else class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12\">\n        \n        <!-- Left Side: Item Summary -->\n        <div class=\"lg:col-span-5 flex flex-col gap-6\">\n          <h2 class=\"text-3xl font-black text-slate-900 tracking-tight\">Order Summary</h2>\n          \n          <div class=\"bg-white p-6 rounded-3xl shadow-sm border border-slate-200\">\n            <div class=\"flex gap-4 items-start mb-6 pb-6 border-b border-slate-100\">\n              <div class=\"w-24 h-24 bg-slate-100 rounded-2xl overflow-hidden shrink-0 border border-slate-200\">\n                <img v-if=\"item.images && item.images.length > 0\" :src=\"item.images[0]\" class=\"w-full h-full object-cover\" />\n                <div v-else class=\"w-full h-full flex items-center justify-center text-slate-400\">\n                  <ShoppingBag class=\"w-8 h-8\" />\n                </div>\n              </div>\n              <div>\n                <h3 class=\"font-bold text-slate-900 text-lg leading-tight mb-1\">{{ item.title }}</h3>\n                <p class=\"text-sm font-medium text-brand-600 mb-2\">₦{{ item.price.toLocaleString() }}</p>\n                <div class=\"inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-100 rounded-md text-xs font-bold text-slate-600\">\n                  <User class=\"w-3.5 h-3.5\" /> Seller: {{ item.sellerId?.firstName || 'Student' }}\n                </div>\n              </div>\n            </div>\n\n            <div class=\"space-y-3 text-sm font-medium text-slate-600\">\n              <div class=\"flex justify-between\">\n                <span>Item Price</span>\n                <span class=\"text-slate-900 font-bold\">₦{{ item.price.toLocaleString() }}</span>\n              </div>\n              <div class=\"flex justify-between\">\n                <span>Delivery Fee ({{ deliveryMethod === 'errander' ? 'Errander' : 'Pickup' }})</span>\n                <span class=\"text-slate-900 font-bold\">{{ deliveryMethod === 'errander' ? `₦${customErranderFee.toLocaleString()}` : 'Free' }}</span>\n              </div>\n              <div class=\"flex justify-between\">\n                <span>Escrow Fee</span>\n                <span class=\"text-slate-900 font-bold\">Free</span>\n              </div>\n            </div>\n            \n            <div class=\"mt-6 pt-6 border-t border-slate-100 flex justify-between items-center\">\n              <span class=\"font-bold text-slate-900 text-lg\">Total</span>\n              <span class=\"font-black text-3xl text-brand-600\">₦{{ totalAmount.toLocaleString() }}</span>\n            </div>\n          </div>\n\n          <div class=\"bg-green-50 border border-green-200 p-5 rounded-2xl flex gap-4 items-start\">\n            <div class=\"w-10 h-10 bg-green-100 rounded-full flex items-center justify-center shrink-0\">\n              <ShieldCheck class=\"w-5 h-5 text-green-600\" />\n            </div>\n            <div>\n              <h4 class=\"font-bold text-green-900 mb-1\">Secure Escrow Payment</h4>\n              <p class=\"text-xs text-green-800 font-medium leading-relaxed\">\n                Your money is held securely in Barter Escrow. The seller does not get paid until you receive the item and confirm you are satisfied.\n              </p>\n            </div>\n          </div>\n        </div>\n        \n        <!-- Right Side: Delivery & Payment Actions -->\n        <div class=\"lg:col-span-7\">\n          <div class=\"bg-white p-8 rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100\">\n            <h2 class=\"text-2xl font-black text-slate-900 mb-6\">Delivery Details</h2>\n            \n            <div class=\"space-y-4 mb-8\">\n              <label class=\"block text-xs font-bold text-slate-700 \">How do you want this?</label>\n              <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                \n                <!-- Self Pickup -->\n                <div \n                  @click=\"deliveryMethod = 'pickup'\"\n                  class=\"flex items-start gap-3 p-4 border-2 rounded-2xl cursor-pointer transition-colors\"\n                  :class=\"deliveryMethod === 'pickup' ? 'border-brand-600 bg-brand-50' : 'border-slate-100 hover:border-brand-300'\"\n                >\n                  <div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 mt-0.5\"\n                       :class=\"deliveryMethod === 'pickup' ? 'border-brand-600' : 'border-slate-300'\">\n                    <div v-if=\"deliveryMethod === 'pickup'\" class=\"w-2.5 h-2.5 bg-brand-600 rounded-full\"></div>\n                  </div>\n                  <div>\n                    <h4 class=\"font-bold text-slate-900\">Self Pickup</h4>\n                    <p class=\"text-xs text-slate-500 mt-1 font-medium leading-relaxed\">Meet with the seller on campus to inspect and collect.</p>\n                    <span class=\"inline-block mt-3 px-2 py-1 bg-slate-200 text-slate-700 text-[10px] font-bold rounded uppercase tracking-widest\">Free</span>\n                  </div>\n                </div>\n                \n                <!-- Errander Delivery -->\n                <div \n                  @click=\"deliveryMethod = 'errander'\"\n                  class=\"flex items-start gap-3 p-4 border-2 rounded-2xl cursor-pointer transition-colors\"\n                  :class=\"deliveryMethod === 'errander' ? 'border-brand-600 bg-brand-50' : 'border-slate-100 hover:border-brand-300'\"\n                >\n                  <div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center shrink-0 mt-0.5\"\n                       :class=\"deliveryMethod === 'errander' ? 'border-brand-600' : 'border-slate-300'\">\n                    <div v-if=\"deliveryMethod === 'errander'\" class=\"w-2.5 h-2.5 bg-brand-600 rounded-full\"></div>\n                  </div>\n                  <div>\n                    <h4 class=\"font-bold text-slate-900\">Errander Delivery</h4>\n                    <p class=\"text-xs text-slate-500 mt-1 font-medium leading-relaxed\">Get it delivered directly to your hostel by an Errander.</p>\n                    <span class=\"inline-block mt-3 px-2 py-1 bg-brand-100 text-brand-700 text-[10px] font-bold rounded uppercase tracking-widest\">Negotiable</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n            \n            <div v-if=\"deliveryMethod === 'errander'\" class=\"mb-8 p-6 bg-slate-50 border border-slate-200 rounded-2xl space-y-6 animate-in fade-in slide-in-from-top-4 duration-300\">\n              <div>\n                <label class=\"block text-xs font-bold text-slate-700 mb-2\">Delivery Address (Hostel/Room)</label>\n                <div class=\"relative\">\n                  <MapPin class=\"absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400\" />\n                  <input v-model=\"deliveryAddress\" type=\"text\" placeholder=\"e.g. Zik Hall, Room C34\" class=\"w-full bg-white border border-slate-200 rounded-xl pl-11 pr-4 py-3.5 outline-none focus:border-brand-500 transition-colors font-medium text-slate-900\" />\n                </div>\n              </div>\n              \n              <div>\n                <label class=\"block text-xs font-bold text-slate-700 mb-1 flex justify-between\">\n                  <span>Your Errander Fee Offer</span>\n                  <span class=\"text-brand-600 font-black\">Base: ₦{{ baseErranderFee.toLocaleString() }}</span>\n                </label>\n                <p class=\"text-xs text-slate-500 mb-3 font-medium\">Offer a fair amount to get a faster response from erranders.</p>\n                <div class=\"relative\">\n                  <span class=\"absolute left-4 top-1/2 -translate-y-1/2 font-black text-slate-400 text-lg\">₦</span>\n                  <input v-model.number=\"customErranderFee\" type=\"number\" :min=\"baseErranderFee\" class=\"w-full bg-white border border-slate-200 rounded-xl pl-9 pr-4 py-3.5 outline-none focus:border-brand-500 transition-colors font-black text-slate-900 text-lg\" />\n                </div>\n              </div>\n            </div>\n            \n            <hr class=\"border-slate-100 mb-8\" />\n            \n            <button @click=\"handleCheckoutAction\" :disabled=\"initiating || (deliveryMethod === 'errander' && !deliveryAddress)\" class=\"w-full bg-brand-600 text-white font-black py-4 rounded-xl flex justify-center items-center gap-2 hover:bg-brand-700 transition-all shadow-lg shadow-brand-500/25 disabled:opacity-50 disabled:bg-slate-400 text-lg\">\n              <Loader2 v-if=\"initiating\" class=\"w-5 h-5 animate-spin\" />\n              <Lock v-else class=\"w-5 h-5\" />\n              {{ initiating ? 'Processing...' : (isLoggedIn ? `Pay ₦${totalAmount.toLocaleString()} Securely` : 'Log in to Checkout') }}\n            </button>\n            <p v-if=\"error\" class=\"mt-4 text-red-500 font-bold text-sm text-center bg-red-50 p-3 rounded-lg\">{{ error }}</p>\n          </div>\n        </div>\n        \n      </div>\n    </div>\n    \n    <AuthModal :isOpen=\"isAuthModalOpen\" @close=\"isAuthModalOpen = false\" @success=\"handleAuthSuccess\" />\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted, computed } from 'vue'\nimport { useRoute, useRouter } from 'vue-router'\nimport { itemsApi, escrowApi, settingsApi } from '~/composables/useApi'\nimport { useAuth } from '~/composables/useAuth'\nimport AuthModal from '~/components/AuthModal.vue'\nimport { ArrowLeft, ShoppingBag, User, ShieldCheck, MapPin, Lock, Loader2 } from 'lucide-vue-next'\n\nconst route = useRoute()\nconst router = useRouter()\nconst { isLoggedIn } = useAuth()\nconst item = ref(null)\n\nuseSeoMeta({\n  title: computed(() => item.value ? `Checkout: ${item.value.title} | Erranders` : 'Checkout | Erranders'),\n  description: 'Secure checkout via Erranders Escrow.',\n})\nconst loading = ref(true)\nconst initiating = ref(false)\nconst error = ref('')\nconst isAuthModalOpen = ref(false)\n\nconst deliveryMethod = ref('pickup')\nconst deliveryAddress = ref('')\nconst baseErranderFee = ref(500)\nconst customErranderFee = ref(500)\n\nconst totalAmount = computed(() => {\n  if (!item.value) return 0\n  const deliveryFee = deliveryMethod.value === 'errander' ? customErranderFee.value : 0\n  return item.value.price + deliveryFee\n})\n\nconst fetchItem = async () => {\n  if (!route.query.itemId) {\n    error.value = 'No item ID provided'\n    loading.value = false\n    return\n  }\n  \n  try {\n    const { data, error: apiError } = await itemsApi.getById(route.query.itemId)\n    if (apiError) {\n       error.value = apiError\n    } else {\n       item.value = data\n    }\n  } catch (err) {\n    error.value = 'Failed to load item details.'\n    console.error(err)\n  } finally {\n    loading.value = false\n  }\n}\n\nconst handleCheckoutAction = () => {\n  if (!isLoggedIn.value) {\n    isAuthModalOpen.value = true\n    return\n  }\n  initiateEscrow()\n}\n\nconst handleAuthSuccess = () => {\n  isAuthModalOpen.value = false\n  initiateEscrow()\n}\n\nconst initiateEscrow = async () => {\n  if (deliveryMethod.value === 'errander' && !deliveryAddress.value) {\n    error.value = 'Please provide a delivery address for the Errander.'\n    return\n  }\n\n  initiating.value = true\n  error.value = ''\n  try {\n    const payload = {\n        sellerId: item.value.sellerId._id || item.value.sellerId,\n        itemId: item.value._id,\n        amount: totalAmount.value,\n        deliveryMethod: deliveryMethod.value,\n        deliveryAddress: deliveryAddress.value\n    }\n    \n    const { data, error: apiError } = await escrowApi.initiate(payload)\n    \n    if (apiError) {\n      error.value = apiError\n    } else {\n      router.push('/escrow')\n    }\n  } catch (err) {\n    error.value = 'Failed to initiate checkout.'\n    console.error(err)\n  } finally {\n    initiating.value = false\n  }\n}\n\nconst fetchSettings = async () => {\n  try {\n    const { data, error } = await settingsApi.get('base_errander_fee')\n    if (!error && data && data.value) {\n      baseErranderFee.value = Number(data.value)\n      customErranderFee.value = Number(data.value)\n    }\n  } catch (err) {\n    console.error('Failed to fetch settings', err)\n  }\n}\n\nonMounted(() => {\n  fetchItem()\n  fetchSettings()\n})\n</script>"],"version":3}