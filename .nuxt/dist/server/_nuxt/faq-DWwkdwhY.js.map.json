{"file":"faq-DWwkdwhY.js","mappings":";;;;;;;;;;;;;;;;AAwBA,eAAW;AAAA,MACT,OAAO;AAAA,IACT,CAAC;;AAzBO,YAAA,QAAAA,eAAAC,WAAA,EAAA,OAAM,uCAAmC,MAAA,CAAA,CAAA,mjCAAA;AAAA;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps"],"sources":["../../../../pages/faq.vue"],"sourcesContent":["<template>\n  <main class=\"min-h-screen bg-white pt-24 pb-16\">\n    <div class=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8\">\n      <h1 class=\"text-4xl font-black text-slate-900 mb-6\">Frequently Asked Questions</h1>\n      <div class=\"space-y-6 mt-10\">\n        <div class=\"border-b border-slate-200 pb-6\">\n          <h3 class=\"text-xl font-bold text-slate-900 mb-2\">How much does it cost to sell an item?</h3>\n          <p class=\"text-slate-600\">Listing an item is completely free! We only take a small platform fee upon successful completion of a sale via Escrow.</p>\n        </div>\n        \n        <div class=\"border-b border-slate-200 pb-6\">\n          <h3 class=\"text-xl font-bold text-slate-900 mb-2\">How does swapping work?</h3>\n          <p class=\"text-slate-600\">You can list an item for swap and specify what you want in return. If someone matches your preference, you can both initiate a swap trade securely.</p>\n        </div>\n\n        <div class=\"border-b border-slate-200 pb-6\">\n          <h3 class=\"text-xl font-bold text-slate-900 mb-2\">What happens if I get scammed?</h3>\n          <p class=\"text-slate-600\">Because of our Escrow system, it is mathematically impossible to get scammed if you follow the rules. Never pay outside the app.</p>\n        </div>\n      </div>\n    </div>\n  </main>\n</template>\n<script setup>\nuseSeoMeta({\n  title: 'FAQ | Erranders Barter',\n})\n</script>"],"version":3}