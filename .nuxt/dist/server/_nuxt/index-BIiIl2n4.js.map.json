{"file":"index-BIiIl2n4.js","mappings":";;;;;;;;;;;;;;;;;;;;AAmGA,UAAM,EAAE,KAAY,IAAI,QAAO;AAC/B,UAAM,QAAQ,IAAI,IAAI;AACtB,UAAM,UAAU,IAAI,IAAI;AAExB,UAAM,WAAW,SAAS,MAAM;AAC9B,UAAI,CAAC,KAAK,MAAO,QAAO;AACxB,aAAO,GAAG,KAAK,MAAM,YAAY,CAAC,KAAK,EAAE,GAAG,KAAK,MAAM,WAAW,CAAC,KAAK,EAAE,GAAG,iBAAiB;AAAA,IAChG,CAAC;;;mBAzGMA,eAAAC,WAAA,EAAA,OAAM,aAAY,GAAA,MAAA,CAAA,wUAOV,SAAA,KAAQ,wFAGiEC,eAAAC,MAAA,IAAA,GAAM,aAAS,QAAA;AAEjF,YAAAC,mBAAAD,MAAA,MAAA,GAAA,EAAA,OAAM,UAAS,GAAA,MAAA,OAAA,CAAA;gBAAOD,eAAAC,MAAA,IAAA,GAAM,cAAU,YAAA,OAAyBD,eAAAC,MAAA,IAAA,GAAM,UAAM,QAAA;UAOhF,QAAA,OAAO;;AACCE,sBAAA,IAAL,MAAC;;;;;;AAMA,cAAAD,mBAAAD,MAAA,OAAA,GAAA,EAAA,OAAM,UAAS,GAAA,MAAA,OAAA,CAAA;AAGuB,cAAA,qJAAAD,eAAA,MAAA,OAAO,kBAAc,CAAA,CAAA,4LAAA;AAKtD,cAAAE,mBAAAD,MAAA,YAAA,GAAA,EAAA,OAAM,UAAS,GAAA,MAAA,OAAA,CAAA;AAGkB,cAAA,sJAAAD,eAAA,MAAA,OAAO,mBAAe,CAAA,CAAA,0LAAA;AAK7D,cAAAE,mBAAAD,MAAA,MAAA,GAAA,EAAA,OAAM,UAAS,GAAA,MAAA,OAAA,CAAA;mLAG0B,MAAA,OAAO,iBAAa,GAAO,eAAc,CAAA,CAAA,0LAAA;AAKpF,cAAAC,mBAAAD,MAAA,IAAA,GAAA,EAAA,OAAM,UAAS,GAAA,MAAA,OAAA,CAAA;AAG0B,cAAA,mJAAAD,eAAA,MAAA,OAAO,gBAAY,KAAA,CAAA,gEAAA;AAAA;;;QAQ1D,IAAG;AAAA,QAAQ,OAAM;AAAA;yBAA3B,CAMW,GAAAI,QAAAC,UAAA,aAAA;;;AAJD,YAAAD,OAAAF,mBAAAD,MAAA,IAAA,GAAA,EAAA,OAAM,4BAAwB,MAAAI,UAAA,QAAA,CAAA;;;;cADtCC,YAEM,OAAA,EAFD,OAAM,6HAA4H,GAAA;AAAA,gBACrIA,YAAuCL,MAAA,IAAA,GAAA,EAAjC,OAAM,yBAAwB,CAAA;AAAA;cAEtCK,YAA4D,MAAA,EAAxD,OAAM,gCAA+B,GAAC,eAAa;AAAA,cACvDA,YAA8E,KAAA,EAA3E,OAAM,qCAAoC,GAAC,8BAA4B;AAAA;;;;;;QAGlE,IAAG;AAAA,QAAoB,OAAM;AAAA;yBAAvC,CAMW,GAAAF,QAAAC,UAAA,aAAA;;;AAJU,YAAAD,OAAAF,mBAAAD,MAAA,eAAA,GAAA,EAAA,OAAM,8BAA0B,MAAAI,UAAA,QAAA,CAAA;;;;cADnDC,YAEM,OAAA,EAFD,OAAM,6HAA4H,GAAA;AAAA,gBACrIA,YAAoDL,MAAA,eAAA,GAAA,EAAnC,OAAM,2BAA0B,CAAA;AAAA;cAEnDK,YAA6D,MAAA,EAAzD,OAAM,gCAA+B,GAAC,gBAAc;AAAA,cACxDA,YAA8E,KAAA,EAA3E,OAAM,qCAAoC,GAAC,8BAA4B;AAAA;;;;;;QAGlE,IAAG;AAAA,QAAW,OAAM;AAAA;yBAA9B,CAMW,GAAAF,QAAAC,UAAA,aAAA;;;AAJC,YAAAD,OAAAF,mBAAAD,MAAA,MAAA,GAAA,EAAA,OAAM,2BAAuB,MAAAI,UAAA,QAAA,CAAA;;;;cADvCC,YAEM,OAAA,EAFD,OAAM,6HAA4H,GAAA;AAAA,gBACrIA,YAAwCL,MAAA,MAAA,GAAA,EAAhC,OAAM,wBAAuB,CAAA;AAAA;cAEvCK,YAA4D,MAAA,EAAxD,OAAM,gCAA+B,GAAC,eAAa;AAAA,cACvDA,YAA+E,KAAA,EAA5E,OAAM,qCAAoC,GAAC,+BAA6B;AAAA;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrInterpolate","_unref","_ssrRenderComponent","_ssrRenderList","_push","_parent","_createVNode"],"sources":["../../../../pages/dashboard/index.vue"],"sourcesContent":["<template>\n  <div class=\"p-4 md:p-8\">\n    <div class=\"max-w-5xl mx-auto\">\n      \n      <!-- Header -->\n      <div class=\"flex flex-col md:flex-row items-start md:items-end justify-between gap-6 mb-10\">\n        <div class=\"flex items-center gap-6\">\n          <div class=\"w-24 h-24 bg-brand-600 rounded-3xl flex items-center justify-center text-white text-3xl font-black shadow-lg shadow-brand-200 shrink-0\">\n            {{ initials }}\n          </div>\n          <div>\n            <h1 class=\"text-3xl md:text-4xl font-black text-slate-900 mb-1\">Welcome, {{ user?.firstName || 'Trader' }}!</h1>\n            <p class=\"text-slate-500 font-medium flex items-center gap-2\">\n              <MapPin class=\"w-4 h-4\" /> {{ user?.university || 'University' }} • {{ user?.hostel || 'Hostel' }}\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <!-- Stats Grid (Pulled from Backend) -->\n      <div v-if=\"loading\" class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12\">\n        <div v-for=\"i in 4\" :key=\"i\" class=\"bg-slate-100 p-6 rounded-3xl animate-pulse h-36\"></div>\n      </div>\n      \n      <div v-else class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12\">\n        <div class=\"bg-white p-6 rounded-3xl border border-slate-100 shadow-sm\">\n          <div class=\"w-12 h-12 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center mb-4\">\n            <Package class=\"w-6 h-6\" />\n          </div>\n          <p class=\"text-slate-500 font-bold text-xs uppercase tracking-widest mb-1\">Active Listings</p>\n          <p class=\"text-3xl font-black text-slate-900\">{{ stats?.activeListings || 0 }}</p>\n        </div>\n        \n        <div class=\"bg-white p-6 rounded-3xl border border-slate-100 shadow-sm\">\n          <div class=\"w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center mb-4\">\n            <CheckCircle2 class=\"w-6 h-6\" />\n          </div>\n          <p class=\"text-slate-500 font-bold text-xs uppercase tracking-widest mb-1\">Completed Trades</p>\n          <p class=\"text-3xl font-black text-slate-900\">{{ stats?.completedTrades || 0 }}</p>\n        </div>\n        \n        <div class=\"bg-white p-6 rounded-3xl border border-slate-100 shadow-sm\">\n          <div class=\"w-12 h-12 bg-purple-50 text-purple-600 rounded-2xl flex items-center justify-center mb-4\">\n            <Wallet class=\"w-6 h-6\" />\n          </div>\n          <p class=\"text-slate-500 font-bold text-xs uppercase tracking-widest mb-1\">Escrow Balance</p>\n          <p class=\"text-3xl font-black text-slate-900\">₦{{ (stats?.escrowBalance || 0).toLocaleString() }}</p>\n        </div>\n        \n        <div class=\"bg-white p-6 rounded-3xl border border-slate-100 shadow-sm\">\n          <div class=\"w-12 h-12 bg-orange-50 text-orange-600 rounded-2xl flex items-center justify-center mb-4\">\n            <Star class=\"w-6 h-6\" />\n          </div>\n          <p class=\"text-slate-500 font-bold text-xs uppercase tracking-widest mb-1\">Seller Rating</p>\n          <p class=\"text-3xl font-black text-slate-900\">{{ stats?.sellerRating || '0.0' }}<span class=\"text-lg text-slate-400\">/5</span></p>\n        </div>\n      </div>\n\n      <!-- Quick Actions -->\n      <div class=\"bg-white rounded-3xl border border-slate-100 p-8 shadow-sm\">\n        <h2 class=\"text-xl font-black text-slate-900 mb-6\">Quick Actions</h2>\n        <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n          <NuxtLink to=\"/sell\" class=\"p-6 bg-slate-50 rounded-2xl border border-slate-100 hover:border-brand-500 hover:bg-white transition-all group flex flex-col items-center text-center\">\n            <div class=\"w-14 h-14 bg-white rounded-full flex items-center justify-center mb-4 shadow-sm group-hover:scale-110 transition-transform\">\n              <Plus class=\"w-6 h-6 text-brand-600\" />\n            </div>\n            <h3 class=\"font-bold text-slate-900 mb-1\">List New Item</h3>\n            <p class=\"text-xs text-slate-500 font-medium\">Sell or swap something fast.</p>\n          </NuxtLink>\n          \n          <NuxtLink to=\"/dashboard/wallet\" class=\"p-6 bg-slate-50 rounded-2xl border border-slate-100 hover:border-brand-500 hover:bg-white transition-all group flex flex-col items-center text-center\">\n            <div class=\"w-14 h-14 bg-white rounded-full flex items-center justify-center mb-4 shadow-sm group-hover:scale-110 transition-transform\">\n              <ArrowDownToLine class=\"w-6 h-6 text-emerald-600\" />\n            </div>\n            <h3 class=\"font-bold text-slate-900 mb-1\">Withdraw Funds</h3>\n            <p class=\"text-xs text-slate-500 font-medium\">Move escrow balance to bank.</p>\n          </NuxtLink>\n          \n          <NuxtLink to=\"/explore\" class=\"p-6 bg-slate-50 rounded-2xl border border-slate-100 hover:border-brand-500 hover:bg-white transition-all group flex flex-col items-center text-center\">\n            <div class=\"w-14 h-14 bg-white rounded-full flex items-center justify-center mb-4 shadow-sm group-hover:scale-110 transition-transform\">\n              <Search class=\"w-6 h-6 text-blue-600\" />\n            </div>\n            <h3 class=\"font-bold text-slate-900 mb-1\">Explore Deals</h3>\n            <p class=\"text-xs text-slate-500 font-medium\">Find the best student trades.</p>\n          </NuxtLink>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { MapPin, Package, CheckCircle2, Wallet, Star, Plus, ArrowDownToLine, Search } from 'lucide-vue-next'\nimport { ref, computed, onMounted } from 'vue'\nimport { useAuth } from '~/composables/useAuth'\n\ndefinePageMeta({ layout: 'dashboard' })\n\nconst { user, token } = useAuth()\nconst stats = ref(null)\nconst loading = ref(true)\n\nconst initials = computed(() => {\n  if (!user.value) return 'U'\n  return `${user.value.firstName?.[0] || ''}${user.value.lastName?.[0] || ''}`.toUpperCase() || 'U'\n})\n\nonMounted(async () => {\n  try {\n    const res = await fetch('http://localhost:3005/api/v1/users/me/stats', {\n      headers: { 'Authorization': `Bearer ${token.value}` }\n    })\n    const data = await res.json()\n    if (res.ok) {\n      stats.value = data\n    }\n  } catch (err) {\n    console.error(err)\n  } finally {\n    loading.value = false\n  }\n})\n</script>\n"],"version":3}