{"file":"settings-DdTss_ju.js","mappings":";;;;;;;;;;;;;;;;;;AA8EA,UAAM,EAAE,KAAyB,IAAI,QAAO;AAE5C,UAAM,UAAU,IAAI,KAAK;AACzB,UAAM,aAAa,IAAI,EAAE;AACzB,UAAM,WAAW,IAAI,EAAE;AAEvB,UAAM,OAAO,IAAI;AAAA,MACf,WAAW;AAAA,MACX,UAAU;AAAA,MACV,gBAAgB;AAAA,MAChB,YAAY;AAAA,MACZ,QAAQ;AAAA,IACV,CAAC;;mBAzFMA,eAAAC,WAAA,EAAA,OAAM,aAAY,GAAA,MAAA,CAAA,wcAcKC,cAAA,SAAA,KAAA,MAAK,SAAS,mRAIdA,cAAA,SAAA,KAAA,MAAK,QAAQ,2SAMvB,SAAOC,MAAA,IAAA,GAAM,KAAK,+TAMVD,cAAA,SAAA,KAAA,MAAK,cAAc,qmBAMhBE,sBAAA,MAAA,QAAA,KAAA,MAAK,UAAU,IAAfC,gBAAA,KAAA,MAAK,YAAU,QAAA,IAAfC,cAAA,KAAA,MAAK,YAAU,QAAA,CAAA,IAAA,cAAA,yCAAfF,sBAAA,MAAA,QAAA,KAAA,MAAK,UAAU,IAAfC,gBAAA,KAAA,MAAK,YAAU,MAAA,IAAfC,cAAA,KAAA,MAAK,YAAU,MAAA,CAAA,IAAA,cAAA,uCAAfF,sBAAA,MAAA,QAAA,KAAA,MAAK,UAAU,IAAfC,gBAAA,KAAA,MAAK,YAAU,MAAA,IAAfC,cAAA,KAAA,MAAK,YAAU,MAAA,CAAA,IAAA,cAAA,2CAAfF,sBAAA,MAAA,QAAA,KAAA,MAAK,UAAU,IAAfC,gBAAA,KAAA,MAAK,YAAU,UAAA,IAAfC,cAAA,KAAA,MAAK,YAAU,UAAA,CAAA,IAAA,cAAA,yCAAfF,sBAAA,MAAA,QAAA,KAAA,MAAK,UAAU,IAAfC,gBAAA,KAAA,MAAK,YAAU,IAAA,IAAfC,cAAA,KAAA,MAAK,YAAU,IAAA,CAAA,IAAA,cAAA,oCAAfF,sBAAA,MAAA,QAAA,KAAA,MAAK,UAAU,IAAfC,gBAAA,KAAA,MAAK,YAAU,KAAA,IAAfC,cAAA,KAAA,MAAK,YAAU,KAAA,CAAA,IAAA,cAAA,uCAAfF,sBAAA,MAAA,QAAA,KAAA,MAAK,UAAU,IAAfC,gBAAA,KAAA,MAAK,YAAU,OAAA,IAAfC,cAAA,KAAA,MAAK,YAAU,OAAA,CAAA,IAAA,cAAA,oIAYhBJ,cAAA,SAAA,KAAA,MAAK,MAAM;UAIpB,WAAA,OAAU;yGAChB,WAAA,KAAU,CAAA,QAAA;AAAA;;;UAEJ,SAAA,OAAQ;qGACd,SAAA,KAAQ,CAAA,QAAA;AAAA;;;4HAIsB,QAAA,KAAO,IAAA,cAAA,wJACnC,QAAA,QAAO,cAAA,cAAA;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrRenderAttr","_unref","_ssrIncludeBooleanAttr","_ssrLooseContain","_ssrLooseEqual"],"sources":["../../../../pages/dashboard/settings.vue"],"sourcesContent":["<template>\n  <div class=\"p-4 md:p-8\">\n    <div class=\"max-w-3xl mx-auto\">\n      \n      <div class=\"mb-10\">\n        <h1 class=\"text-3xl font-black text-slate-900 mb-2\">Account Settings</h1>\n        <p class=\"text-slate-500 font-medium\">Manage your profile details and preferences.</p>\n      </div>\n\n      <div class=\"bg-white rounded-3xl border border-slate-100 shadow-sm p-8\">\n        <form @submit.prevent=\"updateProfile\" class=\"space-y-6\">\n          \n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            <div>\n              <label class=\"block text-xs font-black text-slate-400 mb-2\">First Name</label>\n              <input v-model=\"form.firstName\" required class=\"w-full bg-slate-50 border border-slate-200 rounded-2xl py-4 px-4 font-bold text-slate-900 focus:bg-white focus:border-brand-600 outline-none transition-colors\" />\n            </div>\n            <div>\n              <label class=\"block text-xs font-black text-slate-400 mb-2\">Last Name</label>\n              <input v-model=\"form.lastName\" required class=\"w-full bg-slate-50 border border-slate-200 rounded-2xl py-4 px-4 font-bold text-slate-900 focus:bg-white focus:border-brand-600 outline-none transition-colors\" />\n            </div>\n          </div>\n\n          <div>\n            <label class=\"block text-xs font-black text-slate-400 mb-2\">Email Address</label>\n            <input :value=\"user?.email\" disabled class=\"w-full bg-slate-100 border border-slate-200 rounded-2xl py-4 px-4 font-bold text-slate-500 cursor-not-allowed\" />\n            <p class=\"text-xs text-slate-400 mt-2 font-medium\">Email address cannot be changed.</p>\n          </div>\n\n          <div>\n            <label class=\"block text-xs font-black text-slate-400 mb-2\">WhatsApp Number</label>\n            <input v-model=\"form.whatsappNumber\" type=\"tel\" pattern=\"^0[789][01]\\d{8}$\" title=\"Valid 11-digit Nigerian WhatsApp number\" class=\"w-full bg-slate-50 border border-slate-200 rounded-2xl py-4 px-4 font-bold text-slate-900 focus:bg-white focus:border-brand-600 outline-none transition-colors\" />\n          </div>\n          \n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            <div>\n              <label class=\"block text-xs font-black text-slate-400 mb-2\">University</label>\n              <select v-model=\"form.university\" class=\"w-full bg-slate-50 border border-slate-200 rounded-2xl py-4 px-4 font-bold text-slate-900 focus:bg-white focus:border-brand-600 outline-none transition-colors appearance-none\">\n                <option value=\"UNILAG\">UNILAG</option>\n                <option value=\"CMUL\">CMUL</option>\n                <option value=\"LASU\">LASU</option>\n                <option value=\"YABATECH\">YABATECH</option>\n                <option value=\"UI\">UI</option>\n                <option value=\"OAU\">OAU</option>\n                <option value=\"Other\">Other</option>\n              </select>\n            </div>\n            <div>\n              <label class=\"block text-xs font-black text-slate-400 mb-2\">Hostel / Residence</label>\n              <input v-model=\"form.hostel\" class=\"w-full bg-slate-50 border border-slate-200 rounded-2xl py-4 px-4 font-bold text-slate-900 focus:bg-white focus:border-brand-600 outline-none transition-colors\" />\n            </div>\n          </div>\n\n          <div v-if=\"successMsg\" class=\"p-4 bg-green-50 text-green-600 rounded-xl font-bold text-sm\">\n            {{ successMsg }}\n          </div>\n          <div v-if=\"errorMsg\" class=\"p-4 bg-red-50 text-red-600 rounded-xl font-bold text-sm\">\n            {{ errorMsg }}\n          </div>\n\n          <div class=\"pt-6 mt-6 border-t border-slate-100 flex justify-end\">\n            <button type=\"submit\" :disabled=\"loading\" class=\"px-8 py-4 bg-slate-900 text-white font-black rounded-xl hover:bg-brand-600 transition-colors shadow-lg disabled:opacity-50\">\n              {{ loading ? 'Saving...' : 'Save Changes' }}\n            </button>\n          </div>\n        </form>\n      </div>\n\n    </div>\n  </div>\n</template>\n\n<script setup>\nimport { ref, onMounted } from 'vue'\nimport { useAuth } from '~/composables/useAuth'\n\ndefinePageMeta({ layout: 'dashboard' })\n\nconst { user, token, saveSession } = useAuth()\n\nconst loading = ref(false)\nconst successMsg = ref('')\nconst errorMsg = ref('')\n\nconst form = ref({\n  firstName: '',\n  lastName: '',\n  whatsappNumber: '',\n  university: '',\n  hostel: ''\n})\n\nonMounted(() => {\n  if (user.value) {\n    form.value = {\n      firstName: user.value.firstName || '',\n      lastName: user.value.lastName || '',\n      whatsappNumber: user.value.whatsappNumber || '',\n      university: user.value.university || 'UNILAG',\n      hostel: user.value.hostel || ''\n    }\n  }\n})\n\nconst updateProfile = async () => {\n  loading.value = true\n  successMsg.value = ''\n  errorMsg.value = ''\n  \n  try {\n    const res = await fetch('http://localhost:3005/api/v1/users/me', {\n      method: 'PATCH',\n      headers: {\n        'Content-Type': 'application/json',\n        'Authorization': `Bearer ${token.value}`\n      },\n      body: JSON.stringify(form.value)\n    })\n    \n    const data = await res.json()\n    if (!res.ok) throw new Error(data.message || 'Failed to update profile')\n    \n    // Update local user state\n    saveSession({ access_token: token.value, user: data })\n    successMsg.value = 'Profile updated successfully!'\n    \n    setTimeout(() => successMsg.value = '', 3000)\n  } catch (err) {\n    errorMsg.value = err.message\n  } finally {\n    loading.value = false\n  }\n}\n</script>\n"],"version":3}